// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. MASA & AKUN
// ==========================================

enum Role {
  CUSTOMER
  ADMIN_BIASA
  ADMIN_UTAMA
}

model User {
  id            String      @id @default(uuid())
  email         String      @unique
  passwordHash  String
  name          String?
  whatsapp      String?
  avatarUrl     String?     // Foto profil lokal: /uploads/avatars/<nama-berkas>
  role          Role
  isActive      Boolean     @default(true)
  deactivationReason String?
  deletionRequestedAt DateTime?
  createdAt         DateTime    @default(now()) // Tanggal daftar akun (dipakai panel Kelola Pengguna)

  // FK fields (hanya sekali didefinisikan, tanpa @relation opposite validation)
  sessionUserId String?     // FK ke Session
  cartUserId    String?     // FK ke Cart
  orderCustomerId String?  // FK ke Order pelanggan
}

// Session model - FK ke User via sessionUserId
model Session {
  id            String      @id @default(uuid())
  userId        String      // FK ke User.id
  tokenHash     String      @unique
  expiresAt     DateTime

  // FK ke User (didefinisikan di sini, bukan di model User)
  userSessionId String? // Referensi ke userId Session
}

// OtpAndRecoveryToken model - FK ke User via userId
model OtpAndRecoveryToken {
  id            String      @id @default(uuid())
  userId        String      // FK ke User.id
  codeHash      String
  type          String      // "OTP_SENSITIF" | "RESET_PASSWORD" | "RECOVERY_ADMIN"
  failedAttempts Int         @default(0)
  expiresAt     DateTime
  usedAt        DateTime?

  // FK ke User
  userUserId String // FK ke User.id (akan digantikan oleh prisma relation saat migrate)
}

// ==========================================
// 2. MASTER BUKU & KATALOG
// ==========================================

model Category {
  id        String      @id @default(uuid())
  name      String      @unique
}

// Stock movement history untuk mencatat setiap perubahan stok
model StockMovement {
  id            String      @id @default(uuid())
  bookId        String
  type          String      // "MASUK" | "KELUAR" | "ADJUSTMENT"
  quantity      Int
  reason        String?
  createdAt     DateTime    @default(now())
  createdBy     String?     // User ID yang melakukan perubahan
}

// Model Buku
model Book {
  id                String      @id @default(uuid())
  code              String      @unique
  title               String
  author             String
  publisher          String
  publishYear        Int
  imageUrl           String?
  description        String?
  sellingPrice       Int
  costPrice          Int        // Rahasia: Khusus Admin Utama (GR-03, BR-004)
  stockTotal         Int         // Stok agregat >= 0 per judul (GR-08)
  stockReserved      Int         // Stok ditahan order aktif (BR-010)
  status             String      // "TERSEDIA" | "SEDANG_DIPESAN" | "TERJUAL" | "NONAKTIF"

  // OD-02: Kolom penggabungan buku duplikat
  mergedIntoBookId   String?     // Referensi ke buku utama jika ini adalah duplikat

  // FK ke Category
  categoryId       String

  // Riwayat harga modal (Admin Utama saja)
  BookCostHistory   BookCostHistory[]
}

// BookCategory many-to-mana menggunakan @@unique
model BookCategory {
  bookId    String
  categoryId String
  @@unique([bookId, categoryId])
}

// Tanda buku / wishlist pelanggan: satu tandaan per pasangan pelanggan + buku.
// Mengikuti pola ID scalar pada schema ini; keberadaan buku divalidasi server.
// Tidak menyimpan modal/laba (GR-03).
model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  bookId    String
  createdAt DateTime @default(now())

  @@unique([userId, bookId])
  @@index([userId, createdAt])
}

// Riwayat harga modal (Admin Utama saja) - model terpisah dengan @relation
model BookCostHistory {
  id            String      @id @default(uuid())
  bookId        String
  oldCostPrice  Int
  newCostPrice  Int
  reason        String
  changedById   String      // Admin Utama ID
  createdAt     DateTime    @default(now())

  book          Book        @relation(fields: [bookId], references: [id])
}

// ==========================================
// 3. KERANJANG & PESANAN
// ==========================================

model Cart {
  id            String      @id @default(uuid())
  userId        String      @unique
  userUserId    String

  // BR-012: versi & tinjauan ulang keranjang setelah penyesuaian stok
  version         Int       @default(0)
  approvedVersion Int       @default(0)
  needsReview     Boolean   @default(false)
  reviewReason    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
}

model CartItem {
  id            String      @id @default(uuid())
  cartId        String
  bookId        String
  quantity      Int         // Kuantitas buku di keranjang (tanpa menahan stok, BR-010)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt

  // FK ke Cart
  cartCartId    String
  // FK ke Book
  bookBookId    String

  @@unique([cartId, bookId])
}

// Model Order (status sesuai state machine BR-001 s.d. BR-026)
model Order {
  id                 String      @id @default(uuid())
  orderNumber     String      @unique
  idempotencyKey   String      @unique
  customerId      String

  // Status utama (Order Status Domain - BR-005, BR-001)
  orderStatus      String      // "MENUNGGU_PEMBAYARAN" | "SUDAH_DIBAYAR" | "MENUNGGU_DIAMBIL" | "SELESAI" | "DIBATALKAN"

  // Status bukti pembayaran (Payment Evidence Domain - BR-006)
  paymentProofStatus PaymentProofStatus // "BELUM_DIUNGGAH" | "MENUNGGU_VERIFIKASI" | "PERLU_BUKTI_BARU" | "TERVERIFIKASI"

  // Status jadwal pengambilan (Pickup Domain - BR-006)
  pickupStatus       PickupStatus // "MENUNGGU_KONFIRMASI" | "DISETUJUI" | "PERLU_TANGGAL_BARU" | "PERUBAHAN_MENUNGGU_PERSETUJUAN"

  // Status refund (Refund Domain - BR-020)
  refundStatus       RefundStatus // "TIDAK_BERLAKU" | "PERLU_DIPROSES" | "DIKEMBALIKAN_SEBAGIAN" | "SELESAI"

  paymentMethod      PaymentMethod // "QRIS" | "TUNAI_CFD"
  pickupSundayDate   DateTime    // Tanggal Minggu di masa depan (BR-018, tutup 09.00)
  pickupGroupId      String?     // Opsional: gabung jadwal dengan pesanan lain
  paymentDeadline    DateTime    // Tenggat 24 jam sejak pembuatan (BR-009, BR-DUE-001)
  totalAmount        Int         @default(0) // Total nominal snapshot pesanan (BR-011)
  pausedRemainingSeconds Int?     // Sisa detik saat jeda (BR-016)
  pausedAt           DateTime?   // Waktu mulai jeda; hanya untuk pengajuan ubah metode
  lockedByAdminId    String?     // Admin yang mengunci order (seperti BR-002)
  lockExpiresAt      DateTime?   // Waktu kunce habis
  allocatedAmount    Int?        // Alih-alih nominal total, tracking per-allocation (OD-03)

  // ===== Tahap 8: Pembayaran, verifikasi 2 tahap, tenggat & race condition =====
  cancelReason       String?     // Alasan pembatalan (termasuk auto-cancel)
  stockReleased      Boolean     @default(false) // Idempotensi pelepasan stok (1x)
  autoCancelled      Boolean     @default(false)
  paymentReviewStatus String     @default("BELUM_DIPERIKSA")
  paymentReviewerId  String?     // Pemeriksa awal (Admin Biasa) / pengambil alih (Admin Utama)
  paymentRejectedCount Int       @default(0) // Hitungan penolakan final Admin Utama
  paymentRejectReason String?
  proofRequestReason String?
  proofDeadline      DateTime?   // Tenggat pengganti saat diminta bukti baru
  paidAt             DateTime?
  paymentRecordedById String?
  paymentRecordedMethod PaymentMethod?
  methodChangeStatus String      @default("TIDAK_ADA")
  methodChangeTo     PaymentMethod?
  methodChangeReason String?
  methodChangeRequestedAt DateTime?
  methodChangeDecidedAt DateTime?
  methodChangeDecidedById String?
  reminderStep       Int         @default(0) // Anti-duplikasi pengingat 2 jam

  // ===== Tahap 9: Jadwal, no-show, dan penyerahan fisik =====
  noShowAt           DateTime?   // WIB 09.00 lewat tanpa pengambilan (BR-019)
  noShowHoldDeadline DateTime?   // Tenggat penahanan buku setelah no-show (tanpa auto-cancel)
  noShowReason       String?     // Alasan penahanan terakhir
  noShowCount        Int         @default(0)
  completedAt        DateTime?   // Waktu serah terima buku secara fisik (FR-DONE-001)
  completedById      String?     // Admin yang menekan tombol Selesai
  stockSold          Boolean     @default(false) // Idempotensi pengurangan stok saat Selesai

  // ===== Tahap 10: Pembatalan, refund terpisah, dan koreksi Selesai =====
  cancelledAt        DateTime?   // Waktu pembatalan final (BR-007)
  cancelledById      String?     // Pelaku pembatalan
  cancelledByRole    String?     // CUSTOMER | ADMIN_BIASA | ADMIN_UTAMA | SYSTEM
  cancelReasonTambahan String?   // Alasan tambahan wajib untuk 1 Admin Utama yang membatalkan pesanan lunas
  stockReleasedAt    DateTime?   // Waktu pelepasan stok tertahan (1x)
  stockReleasedById  String?     // Pelaku pelepasan stok
  refundNominal      Int?        // Snapshot nominal pembayaran yang menjadi dasar refund
  koreksiSelesaiAt   DateTime?   // Waktu koreksi pesanan Selesai oleh Admin Utama
  koreksiSelesaiById String?     // Admin Utama yang mengoreksi Selesai

  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @default(now()) @updatedAt

  // FK ke User
  customerUserId   String

  @@index([customerId])
  @@index([orderStatus])
}

// OrderItem: snapshot harga & kuantitas per buku di dalam order (BR-011)
model OrderItem {
  id            String      @id @default(uuid())
  orderId       String
  bookId        String
  quantity      Int
  snapshotCode  String      @default("") // Kode buku saat order dibuat
  snapshotTitle String      // Judul pada saat order dibuat (tidak berubah)
  snapshotSellingPrice Int      // Harga jual pada saat order (BR-011 - snapshot tidak berubah)
  snapshotCostPrice Int       // Cost price snapshot (Rahasia: Admin Utama, BR-004)
  subtotal      Int         @default(0) // quantity x snapshotSellingPrice

  // FK ke Order
  orderOrderId   String
  // FK ke Book
  bookBookId     String
}

// Riwayat status order (audit - BR-024 immutable)
model OrderStatusHistory {
  id            String      @id @default(uuid())
  orderId       String
  domain        String      // "ORDER" | "PAYMENT" | "PICKUP" | "REFUND"
  oldStatus     String
  newStatus     String
  reason        String?
  actorId       String
  actorRole     String
  createdAt     DateTime    @default(now())

  // FK ke Order
  orderOrderId   String
}

// ==========================================
// 4. PEMBAYARAN QRIS & BUKTI
// ==========================================

model QrisConfig {
  id            String      @id @default(uuid())
  imageUrl      String      // Endpoint aman: /api/qris/gambar/[id]
  storageName   String      // Nama berkas di penyimpanan privat (tidak diekspos)
  isActive      Boolean
  uploadedById  String
  replacedById  String?
  replacedAt    DateTime?
  keterangan    String?
  createdAt     DateTime    @default(now())

  // FK ke User
  userUserId    String

  @@index([isActive])
}

// PaymentEvidence: bukti transfer yang diunggah customer (BR-014, BR-015)
model PaymentEvidence {
  id            String      @id @default(uuid())
  imageUrl      String      // Endpoint aman: /api/pembayaran/bukti/[id]
  storageName   String
  status        String
  amount        Int         @default(0) // Total transfer yang dibuktikan (untuk multi-order)
  isLatest      Boolean     @default(true) // Riwayat bukti lama tetap tersimpan
  rejectionCount Int        @default(0)
  initialCheckedById String?
  initialCheckedAt DateTime?
  finalApprovedById String?
  finalDecisionAt DateTime?
  rejectionReason String?
  proofRequestReason String?
  proofDeadline  DateTime?
  supersededAt   DateTime?
  qrisConfigId   String?     // QRIS historis yang dipakai saat transfer
  uploadedAt     DateTime    @default(now())
  updatedAt      DateTime    @default(now()) @updatedAt

  // FK ke User
  userUserId    String

  @@index([isLatest])
}

// OrderPaymentAllocation: relasi many-to-many antar Order dan PaymentEvidence (OD-03)
// Satu bukti QRIS bisa dialokasikan ke banyak pesanan dengan nominal terpercaya
model OrderPaymentAllocation {
  id               String      @id @default(uuid())
  orderId          String
  paymentEvidenceId String
  allocatedAmount  Int         // Nominal yang dialokasikan ke pesanan ini (total bukti = sum allocations)
  createdAt        DateTime    @default(now())

  // FK ke Order
  orderOrderId   String
  // FK ke PaymentEvidence
  paymentEvidenceUserId String

  @@unique([orderId, paymentEvidenceId])
  @@index([paymentEvidenceId])
}

// Riwayat keputusan verifikasi pembayaran (BR-014, append-only secara aplikasi)
model PaymentVerificationRecord {
  id           String      @id @default(uuid())
  orderId      String
  evidenceId   String
  stage        String      // PEMERIKSAAN_AWAL | KEPUTUSAN_FINAL | PENGAMBILAN_ALIH | PERMINTAAN_BUKTI_BARU
  decision     String      // DITERUSKAN | DITOLAK | DISETUJUI | DIMINTA_BARU | DIAMBIL_ALIH
  actorId      String
  actorRole    String
  reason       String?
  createdAt    DateTime    @default(now())

  @@index([orderId])
}

// Pengajuan perubahan metode pembayaran — hanya ini yang menjeda timer (BR-016)
model PaymentMethodChangeRequest {
  id            String      @id @default(uuid())
  orderId       String
  requestedById String
  fromMethod    PaymentMethod
  toMethod      PaymentMethod
  reason        String?
  status        String      @default("MENUNGGU_PERSETUJUAN")
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime    @default(now())

  @@index([orderId])
}

// Pengajuan/keputusan perpanjangan tenggat — TIDAK menjeda timer (BR-016)
model PaymentDeadlineExtension {
  id            String      @id @default(uuid())
  orderId       String
  requestedById String
  oldDeadline   DateTime
  proposedDeadline DateTime
  approvedDeadline DateTime?
  reason        String
  status        String      @default("MENUNGGU_PERSETUJUAN")
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime    @default(now())

  @@index([orderId])
}

// Riwayat pengajuan/usulan perubahan jadwal (Tahap 9, FR-PICK-001)
// Tanggal aktif pada Order sengaja tidak diubah sampai pihak lawan menyetujui (AC-PICK-001).
model JadwalPerubahan {
  id              String      @id @default(uuid())
  orderId         String
  jenis           String      // PENGAJUAN_CUSTOMER | USULAN_ADMIN
  pengajuId       String
  peranPengaju    String      // CUSTOMER | ADMIN_BIASA | ADMIN_UTAMA
  tanggalLama     DateTime
  tanggalBaru     DateTime    // Selalu pukul 09.00 WIB
  statusSebelumnya String?    // Dipakai saat pengaju membatalkan usulannya sendiri
  alasan          String?
  status          String      @default("MENUNGGU_PERSETUJUAN")
  // MENUNGGU_PERSETUJUAN | DISETUJUI | DITOLAK | DIBATALKAN
  diputuskanOleh  String?
  diputuskanPeran String?
  alasanKeputusan String?
  diputuskanPada  DateTime?
  createdAt       DateTime    @default(now())

  @@index([orderId, status])
}

// ==========================================
// 5. REFUND & PENJUALAN OFFLINE
// ==========================================

model RefundRecord {
  id            String      @id @default(uuid())
  orderId       String?
  refundAmount  Int
  reason        String
  processedById String
  refundedAt    DateTime    @default(now())

  // ===== Tahap 10: status proses terpisah dari status pembatalan pesanan =====
  status        String      @default("SELESAI") // MENUNGGU_PERSETUJUAN | SELESAI | DITOLAK
  metode        String?     // TRANSFER_BANK | TUNAI | QRIS | LAINNYA
  bukti         String?     // Referensi/bukti proses pengembalian dana
  catatan       String?
  approvedById  String?     // Wajib diisi Admin Utama sebelum status menjadi SELESAI
  approvedAt    DateTime?
  createdAt     DateTime    @default(now())

  // FK ke Order
  orderOrderId   String?
  // FK ke User
  processorUserId String

  @@index([orderId, status])
}

// OfflineSale: penjualan langsung di booth CFD (BR-012, FR-OFF-001)
model OfflineSale {
  id            String      @id @default(uuid())
  recordedById  String
  soldAt        DateTime    @default(now())
  status        String      @default("SELESAI") // Penjualan langsung selalu Selesai
  catatan       String?     // Catatan opsional dari admin
  idempotencyKey String?    @unique // Anti-duplikat pencatatan (BR-008)

  // FK ke User
  userUserId    String

  @@index([soldAt])
}

// OfflineSaleItem: item dalam penjualan offline (BR-012, BR-OFF-001)
model OfflineSaleItem {
  id            String      @id @default(uuid())
  offlineSaleId String
  bookId        String
  quantity      Int
  actualSellingPrice Int     // Harga jual aktual (boleh beda dari katalog)
  costPrice     Int          // Snapshot modal per unit saat transaksi (BR-021/BR-022)
  snapshotTitle String      @default("")
  snapshotCode  String      @default("")
  subtotal      Int         @default(0) // quantity x actualSellingPrice

  // FK ke OfflineSale
  offlineSaleOfflineSaleId String
  // FK ke Book
  bookBookId     String

  @@index([offlineSaleId])
}

// Usul koreksi harga penjualan offline — berlaku hanya setelah disetujui Admin Utama
// (FR-OFF-001). Harga & laba lama tetap aktif sebelum keputusan (BR-022).
model OfflinePriceCorrection {
  id                String    @id @default(uuid())
  offlineSaleId     String
  offlineSaleItemId String
  pengajuId         String
  peranPengaju      String    // ADMIN_BIASA | ADMIN_UTAMA
  hargaLama         Int
  hargaBaru         Int
  alasan            String    // Wajib diisi pengaju
  status            String    @default("MENUNGGU_PERSETUJUAN")
  // MENUNGGU_PERSETUJUAN | DISETUJUI | DITOLAK | DIBATALKAN
  disetujuiOlehId   String?   // Admin Utama
  disetujuiPada     DateTime?
  alasanKeputusan   String?
  createdAt         DateTime  @default(now())

  @@index([offlineSaleId, status])
  @@index([status])
}

// ==========================================
// 6. TOKO LIBUR & STATUS
// ==========================================

model StoreStatus {
  id            String      @id @default(uuid())
  isOpen        Boolean
  activeClosureReason String?
  updatedAt     DateTime @default(now())
}

model StoreClosureHistory {
  id            String      @id @default(uuid())
  closedAt      DateTime
  reopenedAt    DateTime?
  actorNameSnapshot String
  actorRoleSnapshot String
  lastReason    String
  actorUserId String
}

model Banner {
  id                String      @id @default(uuid())
  title               String?
  description         String?
  imageUrl            String      // Wajib diunggah
  url                String?     // URL tujuan (opsional)
  sortOrder         Int         @default(0)
  status             String      // "PENDING" | "ACTIVE" | "INACTIVE" | "REJECTED" | "CANCELLED"
  submittedById      String      // User ID pengaju
  rejectedById       String?     // Admin Utama yang menolak
  rejectedAt         DateTime?
  rejectReason       String?     // Alasan penolakan (hanya terbaca Admin Utama)
  createdAt         DateTime    @default(now())
}

// ==========================================
// 7. NOTIFIKASI & PENGINGAT
// ==========================================

model Notification {
  id            String      @id @default(uuid())
  userId        String
  groupKey      String
  kategori      String      @default("UMUM") // PEMBAYARAN | JADWAL | PESANAN | SISTEM | PENJUALAN | UMUM
  entitasId     String?     // Id pesanan/transaksi terkait untuk pengelompokan
  message       String
  metadata      Json?       // Data tambahan; wajib disaring untuk Admin Biasa (GR-03)
  isRead        Boolean @default(false)
  readAt        DateTime?
  retryCount    Int @default(0)
  createdAt     DateTime @default(now())

  // FK ke User
  userUserId    String

  // BR-008: satu notifikasi per (penerima, kunci pengiriman)
  @@unique([userId, groupKey])
  @@index([userId, isRead, createdAt])
  @@index([userId, kategori, entitasId])
}

model ScheduledReminder {
  id            String      @id @default(uuid())
  orderId       String?
  type          String
  jobKey        String?     @unique // Kunci antrean persisten anti-duplikat
  intervalMenit Int         @default(120) // Pengingat setiap 2 jam
  zonaWaktu     String      @default("Asia/Jakarta")
  nextRunAt     DateTime
  terakhirDijalankan DateTime?
  isResolved    Boolean @default(false)
  createdAt     DateTime    @default(now())

  // FK ke Order
  orderOrderId   String?

  @@index([isResolved, nextRunAt])
}

/**
 * Outbox persisten untuk pengiriman eksternal (email/WA masa depan).
 * deliveryKey unik menjamin idempotent delivery meski retry berulang (BR-008, NFR-01).
 */
model NotificationOutbox {
  id                 String      @id @default(uuid())
  deliveryKey        String      @unique
  userId             String
  kanal              String      @default("IN_APP") // IN_APP | EMAIL | WHATSAPP
  kategori           String      @default("UMUM")
  entitasId          String?
  message            String
  status             String      @default("PENDING") // PENDING | TERKIRIM | GAGAL | DITINDAKLANJUTI
  attempts           Int         @default(0)
  maxAttempts        Int         @default(5)
  nextAttemptAt      DateTime    @default(now())
  lastError          String?
  sentAt             DateTime?
  escalationNotified Boolean     @default(false)
  createdAt          DateTime    @default(now())

  @@index([status, nextAttemptAt])
  @@index([userId, status])
}

// ==========================================
// 8. BACKUP TERENKRIPSI AGE (NFR-04, TAHAP 13)
// ==========================================

model BackupArsip {
  id              String      @id @default(uuid())
  namaFile        String      @unique
  ukuranByte      Int         @default(0)
  jenis           String      // HARIAN | MANUAL
  status          String      @default("BERHASIL") // BERHASIL | GAGAL | DIHAPUS
  checksumSha256  String?     // Integritas arsip terenkripsi
  dibuatOlehId    String?     // Null untuk backup otomatis/Sistem
  keterangan      String?
  dihapusPada     DateTime?   // Penanda retensi 30 hari; riwayat tetap ada
  createdAt       DateTime    @default(now())

  @@index([createdAt, status])
  @@index([jenis, status])
}

// ==========================================
// 9. AUDIT LOG IMMUTABLE (BR-024, GR-06)
// ==========================================

model AdminAuditLog {
  id            String      @id @default(uuid())
  actorId       String
  actorRoleSnapshot String
  action        String
  targetEntity  String
  targetId      String
  oldValue      Json
  newValue      Json
  reason        String?
  createdAt     DateTime @default(now())
}

// ==========================================
// 10. ENUM STATIS & PENNGAT
// ==========================================

enum BookStatus {
  TERSEDIA
  SEDANG_DIPESAN
  TERJUAL
  NONAKTIF
}

enum OrderStatus {
  MENUNGGU_PEMBAYARAN
  SUDAH_DIBAYAR
  MENUNGGU_DIAMBIL
  SELESAI
  DIBATALKAN
}

enum PaymentProofStatus {
  BELUM_DIUNGGAH
  MENUNGGU_VERIFIKASI
  PERLU_BUKTI_BARU
  TERVERIFIKASI
}

enum PickupStatus {
  MENUNGGU_KONFIRMASI
  DISETUJUI
  PERLU_TANGGAL_BARU
  PERUBAHAN_MENUNGGU_PERSETUJUAN
  TIDAK_HADIR
}

enum RefundStatus {
  TIDAK_BERLAKU
  PERLU_DIPROSES
  DIKEMBALIKAN_SEBAGIAN
  SELESAI
}

enum PaymentMethod {
  QRIS
  TUNAI_CFD
}
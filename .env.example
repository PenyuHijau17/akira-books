# Contoh konfigurasi environment untuk Akira Books.
# File ini boleh di-commit ke Git karena HANYA berisi placeholder — jangan isi nilai rahasia di sini.
# Salin ke ".env.local" (tidak di-commit) atau ekspor variabel sebelum `docker compose up`.
# Compose membaca .env dari folder proyek; nilai di dalam container dikunci lewat compose.yaml.

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
# Di host (CMD/PowerShell): localhost + port yang dipetakan Compose (5433).
# Di dalam container app: Compose mengisi otomatis (host "db", port 5432),
# sehingga nilai DATABASE_URL di .env TIDAK menimpa nilai container.
DATABASE_URL="postgresql://<user>:<password>@localhost:5433/<nama_database>?schema=public"

# ---------------------------------------------------------------------------
# KEAMANAN SESI & SERVER ACTIONS
# ---------------------------------------------------------------------------
# Wajib stabil di Docker self-hosted. Buat nilai acak minimal 32 karakter,
# simpan hanya di file .env lokal / secret manager pemilik toko.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="<nilai-acak-minimal-32-karakter>"
# SESSION_SECRET="<nilai-acak-minimal-32-karakter>"

# ---------------------------------------------------------------------------
# NOTIFIKASI EKSTERNAL (OD-04)
# ---------------------------------------------------------------------------
# Kosongkan untuk mematikan pengiriman eksternal.
# Set ke "terminal" hanya untuk mencetak notifikasi ke log terminal server.
# Tidak menambah layanan eksternal / Mailpit.
AKIRA_NOTIF_EKSTERNAL=""

# ---------------------------------------------------------------------------
# BACKUP TERENKRIPSI AGE (NFR-04, TAHAP 13)
# ---------------------------------------------------------------------------
# Kunci PUBLIK/penerima age (bentuk age1...). Dihasilkan dengan:
#   age-keygen -o kunci-privat-age.txt
#   age-keygen -y kunci-privat-age.txt   <- salin outputnya ke variabel ini
# Kunci PRIVAT disimpan terpisah oleh pemilik toko, TIDAK pernah dimasukkan
# ke repositori, .env.example, atau image Docker.
AKIRA_BACKUP_AGE_PUBLIC_KEY="<kunci-publik-age1...>"

# Folder arsip terenkripsi di dalam container (default: /app/backup-arsip).
AKIRA_BACKUP_DIR="/app/backup-arsip"

# Folder seluruh berkas media/upload yang ikut dibackup (default: /app/storage).
AKIRA_BACKUP_MEDIA_DIR="/app/storage"

# Retensi arsip dalam hari (default dan ketentuan NFR-04: 30 hari).
AKIRA_BACKUP_RETENSI_HARI="30"

# Jam backup otomatis harian dalam WIB (Asia/Jakarta, default 02:00).
AKIRA_BACKUP_JAM_WIB="02:00"

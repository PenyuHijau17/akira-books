# Contoh konfigurasi environment untuk Akira Books.
# File ini boleh di-commit ke Git karena hanya berisi placeholder.
# Salin ke ".env.local" (tidak di-commit) atau isi nilainya di dalam Docker Compose.

# Koneksi database PostgreSQL.
# - Di host (CMD/PowerShell): gunakan localhost dan port yang dipetakan di compose.yaml (5433).
# - Di dalam container app: Compose menyediakan DATABASE_URL otomatis (host "db", port 5432),
#   dan nilainya TIDAK ditimpa oleh file .env.
DATABASE_URL="postgresql://<user>:<password>@localhost:5433/<nama_database>?schema=public"

# ---------------------------------------------------------------------------
# Variabel berikut belum dipakai pada tahap fondasi ini.
# Nanti diaktifkan bersama fitur terkait (autentikasi, penyimpanan file, email).
# ---------------------------------------------------------------------------

# Kunci enkripsi untuk Server Actions (wajib stabil di Docker self-hosted).
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="<nilai-acak-minimal-32-karakter>"

# Rahasia penanda/enkripsi cookie sesi.
# SESSION_SECRET="<nilai-acak-minimal-32-karakter>"

# Folder penyimpanan file unggahan (foto buku, QRIS, bukti pembayaran).
# Tidak boleh berada di dalam folder public/.
# STORAGE_DIR="/app/storage"

# Email lokal memakai Mailpit (ditambahkan setelah fondasi Docker & Prisma stabil).
# MAIL_MODE="mailpit"
# SMTP_HOST="mailpit"
# SMTP_PORT="1025"
# SMTP_FROM_EMAIL="akira-books@example.test"